---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import ProblemSection from '../components/ProblemSection.astro';
import WorkflowSection from '../components/WorkflowSection.astro';
import CandidateExperience from '../components/CandidateExperience.astro';
import ProductTabs from '../components/ProductTabs';
import CandidateIntelligence from '../components/CandidateIntelligence.astro';
import FeatureWall from '../components/FeatureWall.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import StatsSection from '../components/StatsSection.astro';
import Pricing from '../components/Pricing.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <NavBar />
  <main>
    <!-- LIGHT: Hero — evidence headline + interactive product tabs -->
    <Hero />
    <!-- LIGHT: Trust strip -->
    <TrustStrip />
    <!-- LIGHT: Problem framing — stats + before/after -->
    <ProblemSection />
    <!-- SOFT BLUE: Workflow pipeline (9 stages connected timeline) -->
    <WorkflowSection />
    <!-- WHITE: Candidate experience & proctoring ethics -->
    <CandidateExperience />
    <!-- LIGHT: Product modules — 5 interactive tabs with mockups -->
    <ProductTabs client:visible />
    <!-- DARK NAVY: Candidate Intelligence visual climax -->
    <CandidateIntelligence />
    <!-- LIGHT: Feature wall — all capabilities -->
    <FeatureWall />
    <!-- SOFT BLUE: Solutions — Corporate / Campus / Staffing -->
    <SolutionsSection />
    <!-- LIGHT: Stats + trust -->
    <StatsSection />
    <!-- LIGHT: Pricing -->
    <Pricing />
    <!-- BRAND BLUE: Final CTA -->
    <FinalCTA />
  </main>
  <!-- DARK NAVY: Footer -->
  <Footer />
</Layout>
