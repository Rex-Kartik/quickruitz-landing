---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NavBar from '../../components/NavBar.astro';
import Footer from '../../components/Footer.astro';

// 1. Generate static paths for all blog posts
export async function getStaticPaths() {
  const blogEntries = await getCollection('blogs');
  return blogEntries.map((entry) => ({
    params: { slug: entry.data.slug || entry.slug },
    props: { entry, allEntries: blogEntries },
  }));
}

// 2. Extract props
const { entry, allEntries } = Astro.props;
const { Content } = await entry.render();

// 3. Format Date
const formattedDate = new Date(entry.data.date).toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
});

// 4. Get 2 related posts
const relatedPosts = allEntries
  .filter((e) => (e.data.slug || e.slug) !== (entry.data.slug || entry.slug))
  .sort(() => 0.5 - Math.random())
  .slice(0, 2);

const shareUrl = encodeURIComponent(`https://quickruitz-landing.kartik-6c9.workers.dev/blogs/${entry.data.slug || entry.slug}`);
const shareTitle = encodeURIComponent(entry.data.title);
---

<Layout title={`${entry.data.title} | QuickRuit Blog`} description={entry.data.excerpt}>
  <NavBar />
  
  <div class="bg-white min-h-screen pt-28 pb-20">
    <div class="max-w-[1200px] mx-auto px-6">
      
      {/* Back Button */}
      <a href="/blogs" class="inline-flex items-center gap-2 text-sm font-medium text-zinc-500 hover:text-blue-600 mb-8 transition-colors group">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 group-hover:-translate-x-1 transition-transform"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
        Back to all articles
      </a>

      {/* HEADER AREA */}
      <div class="max-w-4xl mb-8">
        <h1 class="text-4xl md:text-5xl lg:text-[56px] font-black tracking-tight leading-[1.1] text-zinc-900 mb-8">
          {entry.data.title}
        </h1>

        <div class="flex items-center justify-between border-t border-b border-zinc-100 py-4">
          <div class="flex flex-wrap items-center gap-y-2 gap-x-3">
            <span class="text-xs font-black uppercase tracking-widest text-blue-600 bg-blue-50 px-3 py-1 rounded-full shrink-0">
              {entry.data.category}
            </span>
            <span class="hidden sm:block w-1 h-1 bg-zinc-300 rounded-full"></span>
            <span class="flex items-center gap-1.5 text-sm font-medium text-zinc-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
              {formattedDate}
            </span>
            <span class="hidden sm:block w-1 h-1 bg-zinc-300 rounded-full"></span>
            <span class="flex items-center gap-1.5 text-sm font-medium text-zinc-500">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {entry.data.readTime}
            </span>
          </div>

          <div class="flex items-center gap-2">
            <a href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareTitle}`} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-zinc-100 flex items-center justify-center text-zinc-600 hover:bg-[#1DA1F2] hover:text-white transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
            </a>
            <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`} target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-full bg-zinc-100 flex items-center justify-center text-zinc-600 hover:bg-[#0A66C2] hover:text-white transition-all">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            </a>
          </div>
        </div>
      </div>

      {/* HERO IMAGE */}
      {entry.data.image && (
        <div class="w-full rounded-[24px] md:rounded-[32px] overflow-hidden mb-12 md:mb-16 shadow-xl border border-zinc-200/50 bg-zinc-50">
          <img src={entry.data.image} alt={entry.data.title} class="w-full h-auto object-contain" />
        </div>
      )}

      {/* TWO COLUMN LAYOUT */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        
        {/* CONTENT (LEFT) */}
        <div class="lg:col-span-8">
          <article class="custom-prose max-w-none">
            <Content />
          </article>

          {/* AUTHOR BIO */}
          <div class="mt-16 p-8 rounded-2xl bg-zinc-50 border border-zinc-100 flex flex-col sm:flex-row gap-6 items-center sm:items-start text-center sm:text-left">
            <div class="w-20 h-20 shrink-0 rounded-full bg-white flex items-center justify-center shadow-md overflow-hidden border border-zinc-200 p-2">
              <img src="/assets/quickruit-logo.png" alt="QuickRuit Logo" class="w-full h-full object-contain" />
            </div>
            <div>
              <h4 class="text-xl font-bold text-zinc-900 mb-2">The QuickRuit Team</h4>
              <p class="text-zinc-600 text-[15px] leading-relaxed mb-4">
                We are a team of AI researchers, recruiters, and engineers on a mission to completely eliminate bias from the hiring process. We build smart, skill-based assessment tools that empower both candidates and companies.
              </p>
            </div>
          </div>

          {/* RELATED ARTICLES */}
          {relatedPosts.length > 0 && (
            <div class="mt-16 pt-10 border-t border-zinc-100">
              <h3 class="text-2xl font-black text-zinc-900 mb-8">Related Articles</h3>
              <div class="grid sm:grid-cols-2 gap-6">
                {relatedPosts.map((rPost) => (
                  <a href={`/blogs/${rPost.data.slug || rPost.slug}`} class="group flex flex-col gap-4 p-4 -mx-4 rounded-2xl hover:bg-zinc-50 transition-all cursor-pointer">
                    <div class="w-full h-40 rounded-xl overflow-hidden bg-zinc-100 border border-zinc-200/50">
                      <img src={rPost.data.image} alt={rPost.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <div>
                      <span class="text-xs font-bold text-blue-600 uppercase tracking-widest">{rPost.data.category}</span>
                      <h4 class="text-lg font-bold text-zinc-900 mt-2 leading-tight group-hover:text-blue-600 transition-colors line-clamp-2">
                        {rPost.data.title}
                      </h4>
                    </div>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* RIGHT SIDEBAR (STICKY CTA) */}
        <div class="lg:col-span-4">
          <div class="sticky top-28 space-y-6">
            <div class="relative p-7 rounded-[20px] bg-blue-50/80 border border-blue-100 flex flex-col group hover:bg-blue-50 transition-all duration-300">
              <h3 class="text-xl sm:text-2xl font-black mb-2 text-zinc-900 leading-tight tracking-tight">10x your hiring scale</h3>
              <p class="text-zinc-600 text-sm mb-6 leading-relaxed">
                Find out how much time and money automated AI interviews can save your team without adding recruiter headcount.
              </p>
              <a href="mailto:hello@quickruit.in?subject=ROI Calculator Request" class="mt-auto w-full bg-blue-600 text-white font-semibold h-11 rounded-xl flex items-center justify-center gap-2 hover:bg-blue-700 transition-all shadow-sm">
                Calculate Your ROI
              </a>
            </div>
            
            <div class="relative p-7 rounded-[20px] bg-zinc-50 border border-zinc-200 flex flex-col group hover:bg-zinc-100 transition-all duration-300">
              <h3 class="text-xl sm:text-2xl font-black mb-2 text-zinc-900 leading-tight tracking-tight">Automate the repetitive.<br />Amplify the human.</h3>
              <p class="text-zinc-600 text-sm mb-6 leading-relaxed">
                ✓ AI handles the first round<br/>
                ✓ Skill-first evaluation<br/>
                ✓ 24/7 zero-friction scheduling
              </p>
              <a href={`${import.meta.env.PUBLIC_APP_URL ?? 'https://www.quickruit.in'}/book-demo`} class="mt-auto w-full bg-zinc-900 text-white font-semibold h-11 rounded-xl flex items-center justify-center gap-2 hover:bg-zinc-800 transition-all shadow-sm">
                Try QuickRuit for free
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</Layout>

<style is:global>
  /* Custom Prose Styles replicating the ReactMarkdown styling */
  .custom-prose h2 {
    @apply text-2xl font-black mt-14 mb-5 text-zinc-900 border-l-4 border-blue-600 pl-4;
  }
  .custom-prose h3 {
    @apply text-xl font-bold mt-10 mb-4 text-zinc-900;
  }
  .custom-prose p {
    @apply text-[16px] md:text-[17px] font-medium leading-relaxed text-zinc-900 mb-6;
  }
  .custom-prose ul {
    @apply space-y-3 mb-8 list-none p-0;
  }
  /* Adding custom checkmark to list items via CSS pseudo-element or base classes */
  .custom-prose li {
    @apply flex gap-3 items-start bg-zinc-50 rounded-xl px-4 py-3 border border-zinc-100 text-[16px] font-medium leading-relaxed text-zinc-900;
  }
  .custom-prose li::before {
    content: "✓";
    @apply text-blue-600 font-bold shrink-0;
  }
  .custom-prose strong {
    @apply font-bold text-zinc-900;
  }
  .custom-prose blockquote {
    @apply relative my-10 pl-6 pr-4 py-4 border-l-4 border-blue-600 bg-blue-50/50 rounded-r-xl italic text-zinc-800 text-lg font-medium leading-relaxed;
  }
  .custom-prose a {
    @apply font-bold text-blue-600 underline decoration-blue-200 underline-offset-4 hover:decoration-blue-600 transition-all;
  }
  .custom-prose img {
    @apply w-full rounded-2xl overflow-hidden my-10 border border-zinc-200/50 bg-zinc-50 shadow-md object-cover;
  }
</style>

<script>
  // Client-side script to detect Youtube/LinkedIn/Instagram links and turn them into embeds
  document.addEventListener("DOMContentLoaded", () => {
    const links = document.querySelectorAll(".custom-prose a");
    
    links.forEach((a) => {
      const href = a.getAttribute("href") || "";
      
      const ytMatch = href.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i);
      const igMatch = href.match(/(?:instagram\.com|instagr\.am)\/(?:p|reel|tv)\/([^\/?#&]+)/i);
      const liPostMatch = href.match(/(?:linkedin\.com\/posts\/.*?(ugcPost|activity|share)-([0-9]+))/i);
      const liUrnMatch = href.match(/(?:linkedin\.com\/(?:feed\/update|embed\/feed\/update)\/urn:li:(ugcPost|activity|share):([0-9]+))/i);
      
      if (ytMatch && ytMatch[1]) {
        const wrapper = document.createElement('div');
        wrapper.className = "w-full aspect-video rounded-2xl overflow-hidden my-10 shadow-lg border border-zinc-200/50";
        wrapper.innerHTML = `<iframe src="https://www.youtube.com/embed/${ytMatch[1]}" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="w-full h-full"></iframe>`;
        a.replaceWith(wrapper);
      } 
      else if (igMatch && igMatch[1]) {
        const wrapper = document.createElement('div');
        wrapper.className = "w-full max-w-[400px] mx-auto rounded-2xl overflow-hidden my-10 shadow-lg border border-zinc-200/50 flex justify-center bg-white";
        wrapper.innerHTML = `<iframe src="https://www.instagram.com/p/${igMatch[1]}/embed" title="Instagram video player" frameborder="0" scrolling="no" allowtransparency="true" allow="encrypted-media" class="w-full min-h-[580px] sm:min-h-[600px]"></iframe>`;
        a.replaceWith(wrapper);
      }
      else {
        let liType = "";
        let liId = "";
        if (liPostMatch) {
          liType = liPostMatch[1];
          liId = liPostMatch[2];
        } else if (liUrnMatch) {
          liType = liUrnMatch[1];
          liId = liUrnMatch[2];
        }
        
        if (liType && liId) {
          const wrapper = document.createElement('div');
          wrapper.className = "w-full max-w-[504px] mx-auto rounded-2xl overflow-hidden my-10 shadow-lg border border-zinc-200/50 flex justify-center bg-white";
          wrapper.innerHTML = `<iframe src="https://www.linkedin.com/embed/feed/update/urn:li:${liType}:${liId}?collapsed=1" title="Embedded post" height="542" width="504" frameborder="0" allowfullscreen allow="encrypted-media" class="w-full min-h-[542px]"></iframe>`;
          a.replaceWith(wrapper);
        }
      }
    });
  });
</script>
