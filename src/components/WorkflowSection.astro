---
const pipeline = [
  {
    id: '01',
    phase: 'Setup',
    title: 'Job Created',
    desc: 'Post a role with your JD. QuickRuit matches it to the right assessment template and auto-invites candidates via email or a shareable link.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 12h6M9 16h6M9 8h3M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"/></svg>`,
    color: 'bg-blue-50 border-blue-100',
    iconBg: 'bg-blue-100',
    iconColor: 'text-blue-600',
    dotColor: 'bg-blue-500',
    lineColor: 'from-blue-200',
  },
  {
    id: '02',
    phase: 'Screening',
    title: 'Resumes Screened',
    desc: 'AI parses every uploaded resume against the JD. Top candidates are identified and routed to the assessment — before you read a single CV.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><path d="M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/><path d="M9 12l2 2 4-4"/></svg>`,
    color: 'bg-indigo-50 border-indigo-100',
    iconBg: 'bg-indigo-100',
    iconColor: 'text-indigo-600',
    dotColor: 'bg-indigo-500',
    lineColor: 'from-indigo-200',
  },
  {
    id: '03',
    phase: 'Assessment',
    title: 'Candidate Assessed',
    desc: 'Each candidate completes a timed aptitude + role-specific technical assessment in a proctored, browser-native environment. No app download needed.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    color: 'bg-violet-50 border-violet-100',
    iconBg: 'bg-violet-100',
    iconColor: 'text-violet-600',
    dotColor: 'bg-violet-500',
    lineColor: 'from-violet-200',
  },
  {
    id: '04',
    phase: 'Adaptation',
    title: 'Difficulty Adapts',
    desc: 'Questions adjust in real-time based on each answer. Strong candidates face harder problems — revealing their true ceiling, not just their floor.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    color: 'bg-amber-50 border-amber-100',
    iconBg: 'bg-amber-100',
    iconColor: 'text-amber-600',
    dotColor: 'bg-amber-500',
    lineColor: 'from-amber-200',
    badge: 'Unique to QuickRuit',
  },
  {
    id: '05',
    phase: 'Interview',
    title: 'AI Video Interview',
    desc: 'Candidates record async video responses to role-relevant questions. The AI generates follow-up questions based on prior answers — like a real interview.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M15 10l4.553-2.277A1 1 0 0121 8.72v6.56a1 1 0 01-1.447.9L15 14v-4z"/><rect x="3" y="7" width="12" height="10" rx="2"/></svg>`,
    color: 'bg-pink-50 border-pink-100',
    iconBg: 'bg-pink-100',
    iconColor: 'text-pink-600',
    dotColor: 'bg-pink-500',
    lineColor: 'from-pink-200',
    badge: 'Beta',
  },
  {
    id: '06',
    phase: 'Challenge',
    title: 'Technical Challenge',
    desc: 'For technical roles, candidates complete a live coding problem in a sandboxed environment. Their solution, complexity, and approach are all captured.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M8 9l-3 3 3 3M16 9l3 3-3 3M11 6l-2 8"/></svg>`,
    color: 'bg-emerald-50 border-emerald-100',
    iconBg: 'bg-emerald-100',
    iconColor: 'text-emerald-600',
    dotColor: 'bg-emerald-500',
    lineColor: 'from-emerald-200',
  },
  {
    id: '07',
    phase: 'Evidence',
    title: 'Evidence Generated',
    desc: 'The AI synthesizes every data point — scores, trajectories, answers, video responses — into structured evidence statements about each candidate\'s capabilities.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 3v11M6 11l3 3 3-3M4 17h12"/></svg>`,
    color: 'bg-teal-50 border-teal-100',
    iconBg: 'bg-teal-100',
    iconColor: 'text-teal-600',
    dotColor: 'bg-teal-500',
    lineColor: 'from-teal-200',
    highlight: true,
  },
  {
    id: '08',
    phase: 'Scorecard',
    title: 'Unified Scorecard',
    desc: 'One scorecard, all signals. Aptitude, technical depth, coding quality, and interview performance combined into a single ranked view — with evidence for every score.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M4 16h2v-6H4zM9 16h2V8H9zM14 16h2V4h-2z"/></svg>`,
    color: 'bg-primary-light border-border-blue',
    iconBg: 'bg-primary/10',
    iconColor: 'text-primary',
    dotColor: 'bg-primary',
    lineColor: 'from-primary/20',
  },
  {
    id: '09',
    phase: 'Decision',
    title: 'Recruiter Decides',
    desc: 'You see a ranked shortlist with scores, evidence, and AI reasoning. You make the final call — QuickRuit gives you the proof, not the decision.',
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
    color: 'bg-emerald-50 border-emerald-100',
    iconBg: 'bg-emerald-500',
    iconColor: 'text-white',
    dotColor: 'bg-emerald-600',
    lineColor: 'from-emerald-200',
  },
];
---

<section class="bg-surface-blue py-28" id="pipeline">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Header -->
    <div class="mb-20 text-center">
      <span class="mb-4 inline-block rounded-pill border border-primary/20 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-primary">
        The Evidence Pipeline
      </span>
      <h2 class="text-[40px] sm:text-[48px] font-black leading-[1.1] tracking-tight text-on-surface">
        From application to evidence.<br />
        <span class="text-primary">9 steps. One connected truth.</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg font-medium leading-relaxed text-on-surface-muted">
        Every step generates data. Every data point becomes a signal. Every signal becomes evidence in a scorecard your team can act on.
      </p>
    </div>

    <!-- Desktop: vertical timeline -->
    <div class="hidden lg:block">
      <div class="relative">
        <!-- Central spine line -->
        <div class="absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2 bg-gradient-to-b from-border via-primary/20 to-emerald-200"></div>

        <div class="space-y-0">
          {pipeline.map((step, i) => (
            <div class={`relative flex items-center gap-0 ${i % 2 === 0 ? 'flex-row' : 'flex-row-reverse'}`}>
              
              <!-- Content card -->
              <div class={`w-[calc(50%-2.5rem)] ${i % 2 === 0 ? 'pr-8 text-right' : 'pl-8 text-left'}`}>
                <div class={`group relative rounded-2xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-card ${step.color}`}>
                  {step.badge && (
                    <span class={`mb-2 inline-block rounded-pill px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-widest ${step.badge === 'Beta' ? 'bg-amber-100 text-amber-700' : 'bg-primary/10 text-primary'}`}>
                      {step.badge}
                    </span>
                  )}
                  <div class={`mb-3 flex items-center gap-3 ${i % 2 === 0 ? 'justify-end' : 'justify-start'}`}>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-muted">{step.phase}</p>
                  </div>
                  <h3 class="mb-2 text-xl font-black text-on-surface">{step.title}</h3>
                  <p class="text-sm font-medium leading-relaxed text-on-surface-muted">{step.desc}</p>
                </div>
              </div>

              <!-- Central dot + step number -->
              <div class="relative z-10 flex w-20 flex-shrink-0 flex-col items-center">
                <div class={`flex h-10 w-10 items-center justify-center rounded-full border-4 border-white shadow-md ${step.iconBg}`}>
                  <div class={`h-4 w-4 ${step.iconColor}`} set:html={step.icon} />
                </div>
                <span class="mt-1.5 text-[9px] font-black tracking-widest text-on-surface-muted">{step.id}</span>
              </div>

              <!-- Empty spacer for opposite side -->
              <div class="w-[calc(50%-2.5rem)]"></div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Mobile: vertical linear list -->
    <div class="lg:hidden">
      <div class="relative pl-8">
        <!-- Left spine -->
        <div class="absolute left-3 top-0 bottom-0 w-px bg-gradient-to-b from-border via-primary/20 to-emerald-200"></div>

        <div class="space-y-6">
          {pipeline.map((step) => (
            <div class="relative">
              <!-- Timeline dot -->
              <div class={`absolute -left-[21px] top-5 h-4 w-4 rounded-full border-2 border-white shadow-sm ${step.dotColor}`}></div>
              
              <div class={`rounded-2xl border p-5 transition-all hover:shadow-card ${step.color}`}>
                <div class="mb-2 flex items-center justify-between">
                  <span class="text-[9px] font-bold uppercase tracking-widest text-on-surface-muted">{step.phase} · {step.id}</span>
                  {step.badge && (
                    <span class={`rounded-pill px-2 py-0.5 text-[9px] font-bold uppercase tracking-widest ${step.badge === 'Beta' ? 'bg-amber-100 text-amber-700' : 'bg-primary/10 text-primary'}`}>
                      {step.badge}
                    </span>
                  )}
                </div>
                <h3 class="mb-1.5 text-lg font-black text-on-surface">{step.title}</h3>
                <p class="text-sm font-medium leading-relaxed text-on-surface-muted">{step.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom note -->
    <div class="mt-16 flex flex-col items-center gap-4 text-center sm:flex-row sm:justify-center sm:gap-6">
      <p class="text-sm font-medium text-on-surface-muted">
        Human recruiters make every final hiring decision. QuickRuit provides the evidence — not the answer.
      </p>
      <a
        href="#features"
        class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline"
      >
        Explore each module
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
