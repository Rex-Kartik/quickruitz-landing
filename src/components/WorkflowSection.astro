---
const steps = [
  {
    id: '01',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 12h6M9 16h6M9 8h3M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"/></svg>`,
    title: 'Bulk Screen',
    desc: 'Upload resumes or share a job link. AI matches candidates against your JD and sends assessments automatically.',
    color: 'bg-blue-50 border-blue-100',
    iconBg: 'bg-blue-100',
    iconColor: 'text-blue-600',
  },
  {
    id: '02',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2"/><path d="M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/><path d="M9 12l2 2 4-4"/></svg>`,
    title: 'Assess',
    desc: 'Candidates complete aptitude and role-specific technical assessments — timed, proctored, and remotely monitored.',
    color: 'bg-indigo-50 border-indigo-100',
    iconBg: 'bg-indigo-100',
    iconColor: 'text-indigo-600',
  },
  {
    id: '03',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: 'Adapt',
    desc: 'The AI engine adjusts question difficulty in real-time based on each candidate\'s answers — revealing their true ceiling.',
    color: 'bg-amber-50 border-amber-100',
    iconBg: 'bg-amber-100',
    iconColor: 'text-amber-600',
    highlight: true,
  },
  {
    id: '04',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M15 10l4.553-2.277A1 1 0 0121 8.72v6.56a1 1 0 01-1.447.9L15 14v-4z"/><rect x="3" y="7" width="12" height="10" rx="2"/></svg>`,
    title: 'Interview',
    desc: 'Optional AI-assisted async video interview where follow-up questions are generated based on the candidate\'s prior responses.',
    color: 'bg-violet-50 border-violet-100',
    iconBg: 'bg-violet-100',
    iconColor: 'text-violet-600',
  },
  {
    id: '05',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>`,
    title: 'Evidence',
    desc: 'AI extracts performance signals from every assessment and interview. Each candidate gets a structured scorecard with evidence statements.',
    color: 'bg-emerald-50 border-emerald-100',
    iconBg: 'bg-emerald-100',
    iconColor: 'text-emerald-600',
  },
  {
    id: '06',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
    title: 'Decision',
    desc: 'You see a ranked shortlist with scores, evidence, and AI recommendations. Make informed hiring decisions — fast.',
    color: 'bg-primary-light border-border-blue',
    iconBg: 'bg-primary/10',
    iconColor: 'text-primary',
  },
];
---

<section class="bg-surface-blue py-24">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Header -->
    <div class="mb-16 text-center">
      <span class="mb-4 inline-block rounded-pill border border-primary/20 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-primary">
        The Pipeline
      </span>
      <h2 class="text-[40px] sm:text-[48px] font-black leading-[1.1] tracking-tight text-on-surface">
        From application to evidence.<br />
        <span class="text-primary">One connected pipeline.</span>
      </h2>
      <p class="mx-auto mt-5 max-w-xl text-lg font-medium leading-relaxed text-on-surface-muted">
        Every step generates data. Every data point becomes evidence. Every candidate gets a fair evaluation.
      </p>
    </div>

    <!-- Steps grid (3+3) -->
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {steps.map((step, i) => (
        <div class={`group relative rounded-2xl border p-7 transition-all hover:-translate-y-1 hover:shadow-card ${step.color}`}>
          <!-- Step number -->
          <div class="mb-5 flex items-center justify-between">
            <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${step.iconBg}`}>
              <div class={`h-5 w-5 ${step.iconColor}`} set:html={step.icon} />
            </div>
            <span class="text-[11px] font-black tracking-widest text-on-surface-muted">{step.id}</span>
          </div>

          <h3 class="mb-2 text-xl font-black text-on-surface">{step.title}</h3>
          <p class="text-sm font-medium leading-relaxed text-on-surface-muted">{step.desc}</p>

          {/* Connector arrow (for non-last items in desktop view) */}
          {i < steps.length - 1 && (
            <div class="absolute -right-2 top-1/2 z-10 hidden -translate-y-1/2 lg:block">
              <div class="flex h-5 w-5 items-center justify-center rounded-full border border-border bg-white shadow-sm">
                <svg class="h-2.5 w-2.5 text-on-surface-muted" viewBox="0 0 10 10" fill="none">
                  <path d="M2 5h6M5 2l3 3-3 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                </svg>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom CTA -->
    <div class="mt-12 flex justify-center">
      <a
        href="#features"
        class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:underline"
      >
        Explore each module in detail
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none">
          <path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
