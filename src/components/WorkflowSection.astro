---
const steps = [
  {
    id: "01",
    phase: "Create",
    title: "Create the role",
    desc: "Post a job on QuickRuit, share the link on any job board, or embed it directly on your own careers page.",
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M9 12h6M9 16h6M9 8h3M5 4h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5a1 1 0 011-1z"/></svg>`,
    image: "/images/workflow/JD.png",
    hubTitle: "Post in seconds",
  },
  {
    id: "02",
    phase: "Evaluate",
    title: "Candidates get evaluated by Ryan, your AI recruiter",
    desc: "Adaptive assessments and a real AI-led interview — no scheduling, no manual screening calls.",
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><circle cx="10" cy="10" r="7"/><path d="M10 7v3l2 2"/></svg>`,
    image: "/images/workflow/aieval.png",
    hubTitle: "AI-Powered",
    badge: "AI-Powered",
  },
  {
    id: "03",
    phase: "Review",
    title: "Wake up to a ranked shortlist",
    desc: "Every candidate scored and ranked, with a detailed, evidence-backed scorecard — ready the next morning.",
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M4 16h2v-6H4zM9 16h2V8H9zM14 16h2V4h-2z"/></svg>`,
    image: "/images/workflow/rank.png",
    hubTitle: "Auto Shortlist",
  },
  {
    id: "04",
    phase: "Schedule",
    title: "Schedule the final round",
    desc: "Bring only your strongest candidates to a live interview.",
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><rect x="3" y="4" width="14" height="14" rx="2"/><path d="M16 2v4M8 2v4M3 10h14"/></svg>`,
    image: "/images/workflow/dash.png",
    hubTitle: "Live Dashboard",
  },
  {
    id: "05",
    phase: "Decide",
    title: "Make better hiring decisions",
    desc: "Faster, backed by evidence — not a resume and a hunch.",
    icon: `<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>`,
    image: "/images/workflow/image.png",
    hubTitle: "Hire with Confidence",
    isFinal: true,
  },
];

const iconGradients = [
  { from: "#0052FF", to: "#4f46e5", glow: "rgba(0,82,255,0.35)" },
  { from: "#7c3aed", to: "#a855f7", glow: "rgba(139,92,246,0.35)" },
  { from: "#4f46e5", to: "#6366f1", glow: "rgba(99,102,241,0.35)" },
  { from: "#f59e0b", to: "#f97316", glow: "rgba(245,158,11,0.35)" },
  { from: "#10b981", to: "#14b8a6", glow: "rgba(16,185,129,0.35)" },
];

const accentBgs = [
  "rgba(0,82,255,0.06)",
  "rgba(124,58,237,0.06)",
  "rgba(79,70,229,0.06)",
  "rgba(245,158,11,0.06)",
  "rgba(16,185,129,0.06)",
];
---

<section
  id="how-it-works"
  class="relative overflow-hidden py-12 sm:py-24"
  style="background: #f8faff;"
>
  <!-- Top gradient line -->
  <div
    class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(to right, transparent, rgba(0,82,255,0.4), transparent);"
  ></div>

  <!-- Decorative blobs -->
  <div
    class="pointer-events-none absolute left-1/2 top-1/4 aspect-square w-full max-w-[500px] -translate-x-1/2 rounded-full blur-[100px]"
    style="background: rgba(124,58,237,0.05);"
  ></div>
  <div
    class="pointer-events-none absolute bottom-1/4 right-0 aspect-square w-full max-w-[300px] rounded-full blur-[80px]"
    style="background: rgba(0,82,255,0.04);"
  ></div>

  <!-- Dot grid -->
  <div
    class="pointer-events-none absolute inset-0"
    style="background-image: linear-gradient(rgba(0,0,0,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.025) 1px, transparent 1px); background-size: 32px 32px; mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent); -webkit-mask-image: linear-gradient(to bottom, transparent, black 10%, black 90%, transparent);"
  ></div>

  <div class="container relative z-10 mx-auto max-w-5xl px-4 sm:px-6">

    <!-- Header -->
    <div class="hiw-header mb-12 text-center sm:mb-16" style="opacity:0; transform:translateY(16px);">
      <span class="mb-4 inline-block rounded-full border border-primary/20 bg-white px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-primary">
        How It Works
      </span>
      <h2 class="mb-3 px-2 text-2xl font-black tracking-tight text-on-surface sm:mb-4 sm:text-4xl">
        From job post to hiring decision &mdash;
        <span style="background: linear-gradient(to right, #7c3aed, #4f46e5); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
          in five steps.
        </span>
      </h2>
    </div>

    <!-- Desktop timeline (lg+) -->
    <div class="hiw-core relative hidden lg:block" style="opacity:0;">

      <!-- Vertical spine track -->
      <div
        class="absolute left-1/2 -translate-x-1/2 overflow-hidden"
        style="top:4px; bottom:4px; width:2px; background: rgba(0,82,255,0.08);"
      >
        <div
          class="hiw-spine w-full h-full"
          style="background: linear-gradient(to bottom, #7c3aed, #4f46e5, #10b981); transform: scaleY(0); transform-origin: top; transition: transform 1.5s ease-in-out;"
        ></div>
      </div>

      <!-- Steps -->
      <div class="flex flex-col gap-8 lg:gap-12">
        {steps.map((step, i) => {
          const grad = iconGradients[i];
          const accent = accentBgs[i];
          const isLeft = i % 2 === 0;
          return (
            <div
              class="hiw-row relative flex w-full items-center"
              style={`flex-direction: ${isLeft ? "row" : "row-reverse"}; opacity:0; transform: translateY(30px); transition: opacity 0.6s cubic-bezier(0.23,1,0.32,1), transform 0.6s cubic-bezier(0.23,1,0.32,1);`}
              data-left={isLeft ? "true" : "false"}
            >
              <!-- CARD side (45%) -->
              <div class="hiw-card-wrap w-[45%]">
                <div
                  class="relative z-10 overflow-hidden rounded-3xl border border-slate-200 bg-white p-6 shadow-sm"
                  style="transition: box-shadow 0.3s, border-color 0.3s, transform 0.3s;"
                >
                  <!-- Accent overlay -->
                  <div
                    class="hiw-accent pointer-events-none absolute inset-0 opacity-0"
                    style={`background: ${accent}; transition: opacity 0.5s;`}
                  ></div>

                  <div class="relative z-10">
                    <!-- Top row: gradient icon + text tags -->
                    <div class="mb-5 flex items-center gap-4">
                      <div
                        class="hiw-icon-box flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-2xl shadow-md"
                        style={`background: linear-gradient(135deg, ${grad.from}, ${grad.to}); box-shadow: 0 4px 14px ${grad.glow}; transition: transform 0.3s;`}
                      >
                        <span class="h-5 w-5 text-white" set:html={step.icon} />
                      </div>
                      <div>
                        <div class="mb-1 flex flex-wrap items-center gap-1.5">
                          <span class="rounded bg-slate-100 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-slate-600">
                            Step {step.id}
                          </span>
                          {step.isFinal && (
                            <span class="rounded bg-emerald-50 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-emerald-600">
                              Final
                            </span>
                          )}
                          {step.badge && (
                            <span class="rounded bg-primary/10 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-primary">
                              {step.badge}
                            </span>
                          )}
                        </div>
                        <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-muted">
                          {step.phase}
                        </p>
                      </div>
                    </div>

                    <h3 class="mb-2 text-base font-bold leading-snug text-slate-900">
                      {step.title}
                    </h3>
                    <p class="text-sm leading-relaxed text-slate-500">
                      {step.desc}
                    </p>
                  </div>
                </div>
              </div>

              <!-- CENTRAL spine node (10%) -->
              <div class="relative flex w-[10%] flex-col items-center">
                <div
                  class="hiw-node flex items-center justify-center rounded-full border-[2.5px] bg-white shadow-sm"
                  style={`width:0.875rem; height:0.875rem; border-color: rgba(0,82,255,0.2); transform:scale(0); transition: transform 0.5s cubic-bezier(0.34,1.56,0.64,1) 0.2s;`}
                >
                  <div class="h-full w-full rounded-full" style={`background: linear-gradient(135deg, ${grad.from}, ${grad.to});`}></div>
                </div>
              </div>

              <!-- IMAGE side (45%) -->
              <div class="hiw-img-wrap w-[45%]">
                <div class="relative overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 shadow-[0_15px_40px_rgba(0,0,0,0.08)] group">
                  <img
                    src={step.image}
                    alt={step.title}
                    class="h-auto w-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                  />
                  <!-- Dark gradient overlay -->
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
                  <!-- Floating hub badge -->
                  <div class="absolute bottom-4 left-4 flex items-center gap-2 rounded-xl border border-white/50 bg-white/95 px-3 py-2 shadow-lg backdrop-blur-md">
                    <svg class="h-4 w-4 text-primary" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                    </svg>
                    <span class="text-sm font-bold text-slate-800">{step.hubTitle}</span>
                  </div>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Mobile: vertical linear list (below lg) -->
    <div class="hiw-mobile lg:hidden">
      <div class="relative pl-8">
        <!-- Left spine -->
        <div class="absolute left-3 top-0 bottom-0 w-px" style="background: linear-gradient(to bottom, #7c3aed, #4f46e5, #10b981);"></div>

        <div class="flex flex-col gap-6">
          {steps.map((step, i) => {
            const grad = iconGradients[i];
            const accent = accentBgs[i];
            return (
              <div
                class="hiw-mobile-step relative"
                style="opacity:0; transform: translateY(20px); transition: opacity 0.5s ease, transform 0.5s ease;"
              >
                <!-- Timeline dot -->
                <div
                  class="absolute -left-[21px] top-5 h-4 w-4 rounded-full border-2 border-white shadow-sm"
                  style={`background: linear-gradient(135deg, ${grad.from}, ${grad.to});`}
                ></div>

                <!-- Card -->
                <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
                  <div class="mb-4 flex items-center gap-3">
                    <div
                      class="flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-xl shadow-md"
                      style={`background: linear-gradient(135deg, ${grad.from}, ${grad.to}); box-shadow: 0 4px 14px ${grad.glow};`}
                    >
                      <span class="h-5 w-5 text-white" set:html={step.icon} />
                    </div>
                    <div>
                      <div class="flex flex-wrap items-center gap-1 mb-0.5">
                        <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-wider text-slate-600">
                          Step {step.id}
                        </span>
                        {step.isFinal && (
                          <span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-wider text-emerald-600">
                            Final
                          </span>
                        )}
                        {step.badge && (
                          <span class="rounded bg-primary/10 px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-wider text-primary">
                            {step.badge}
                          </span>
                        )}
                      </div>
                      <p class="text-[9px] font-bold uppercase tracking-widest text-on-surface-muted">{step.phase}</p>
                    </div>
                  </div>
                  <h3 class="mb-1.5 text-sm font-bold leading-snug text-slate-900">{step.title}</h3>
                  <p class="text-xs leading-relaxed text-slate-500">{step.desc}</p>
                </div>

                <!-- Image -->
                <div class="mt-3 overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm group">
                  <div class="relative">
                    <img
                      src={step.image}
                      alt={step.title}
                      class="h-auto w-full object-cover object-left-top transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent"></div>
                    <div class="absolute bottom-3 left-3 flex items-center gap-2 rounded-xl border border-white/50 bg-white/95 px-3 py-1.5 shadow-lg backdrop-blur-md">
                      <svg class="h-3.5 w-3.5 text-primary" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd" />
                      </svg>
                      <span class="text-xs font-bold text-slate-800">{step.hubTitle}</span>
                    </div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ------- Header fade-up -------
  const header = document.querySelector(".hiw-header") as HTMLElement | null;
  if (header) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          header.style.transition = "opacity 0.6s ease, transform 0.6s ease";
          if (e.isIntersecting) {
            header.style.opacity = "1";
            header.style.transform = "translateY(0)";
          } else {
            header.style.opacity = "0";
            header.style.transform = "translateY(16px)";
          }
        });
      },
      { threshold: 0.1 }
    );
    obs.observe(header);
  }

  // ------- Core + spine -------
  const core = document.querySelector(".hiw-core") as HTMLElement | null;
  const spine = document.querySelector(".hiw-spine") as HTMLElement | null;
  if (core && spine) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            core.style.opacity = "1";
            spine.style.transform = "scaleY(1)";
          }
        });
      },
      { threshold: 0.05 }
    );
    obs.observe(core);
  }

  // ------- Desktop rows: bidirectional fade -------
  document.querySelectorAll<HTMLElement>(".hiw-row").forEach((row) => {
    const node = row.querySelector<HTMLElement>(".hiw-node");
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            row.style.opacity = "1";
            row.style.transform = "translateY(0)";
            if (node) node.style.transform = "scale(1)";
          } else {
            row.style.opacity = "0";
            row.style.transform = "translateY(30px)";
            if (node) node.style.transform = "scale(0)";
          }
        });
      },
      { rootMargin: "-80px 0px -80px 0px" }
    );
    obs.observe(row);
  });

  // ------- Mobile steps: bidirectional fade -------
  document.querySelectorAll<HTMLElement>(".hiw-mobile-step").forEach((step) => {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            step.style.opacity = "1";
            step.style.transform = "translateY(0)";
          } else {
            step.style.opacity = "0";
            step.style.transform = "translateY(20px)";
          }
        });
      },
      { rootMargin: "-60px 0px -60px 0px" }
    );
    obs.observe(step);
  });

  // ------- Card hover: accent overlay + icon wiggle + lift -------
  document.querySelectorAll<HTMLElement>(".hiw-card-wrap").forEach((wrap) => {
    const overlay = wrap.querySelector<HTMLElement>(".hiw-accent");
    const iconBox = wrap.querySelector<HTMLElement>(".hiw-icon-box");
    const card = wrap.querySelector<HTMLElement>("div[class*='rounded-3xl']");
    wrap.addEventListener("mouseenter", () => {
      if (overlay) overlay.style.opacity = "1";
      if (iconBox) iconBox.style.transform = "scale(1.06) rotate(-3deg)";
      if (card) {
        card.style.boxShadow = "0 8px 32px rgba(0,0,0,0.08)";
        card.style.borderColor = "rgba(0,82,255,0.2)";
        card.style.transform = "translateY(-2px)";
      }
    });
    wrap.addEventListener("mouseleave", () => {
      if (overlay) overlay.style.opacity = "0";
      if (iconBox) iconBox.style.transform = "";
      if (card) {
        card.style.boxShadow = "";
        card.style.borderColor = "";
        card.style.transform = "";
      }
    });
  });
</script>
