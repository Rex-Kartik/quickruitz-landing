---
const links = {
  Product: ["Features", "Pricing", "Book Demo", "Why QuickRuit"],
  Solutions: ["HR & Recruiting Teams", "Engineering Managers", "Campus Placement Cells"],
  Resources: ["Blog", "Documentation", "API", "Changelog"],
  Legal: ["Privacy Policy", "Terms of Service", "Security", "AI Ethics"],
};
---
<footer class="border-t border-border bg-on-surface py-16">
  <div class="mx-auto max-w-7xl px-6">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-5">
      <!-- Brand -->
      <div class="col-span-2 md:col-span-1">
        <a href="/" class="mb-4 flex items-center gap-2">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary">
            <span class="text-sm font-black text-white">Q</span>
          </div>
          <span class="text-lg font-black text-white">QuickRuit</span>
        </a>
        <p class="text-xs font-medium leading-relaxed text-white/50">
          AI-powered hiring automation for the modern team.
        </p>
      </div>

      <!-- Link groups -->
      {Object.entries(links).map(([group, items]) => (
        <div>
          <h4 class="mb-4 text-xs font-bold uppercase tracking-widest text-white/40">{group}</h4>
          <ul class="space-y-3">
            {items.map(item => (
              <li>
                <a href="#" class="text-sm font-medium text-white/60 transition-colors hover:text-white">{item}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-xs font-medium text-white/40">© 2026 QuickRuit. All rights reserved.</p>
      <p class="text-xs font-medium text-white/40">Built for India's fastest-growing teams.</p>
    </div>
  </div>
</footer>
