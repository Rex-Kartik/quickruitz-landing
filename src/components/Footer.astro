---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';

const links = {
  Platform: [
    { label: 'Video Interviewing', href: '#features' },
    { label: 'Assessment Software', href: '#features' },
    { label: 'Candidate Screening', href: '#features' },
    { label: 'Hiring Automation', href: '#features' },
  ],
  Company: [
    { label: 'Why QuickRuit?', href: '#solutions' },
    { label: 'How it Works', href: '#how-it-works' },
    { label: 'Blogs', href: `${APP_URL}/blogs` },
    { label: 'Pricing', href: '#pricing' },
  ],
  Legal: [
    { label: 'Terms of Use', href: `${APP_URL}/terms` },
    { label: 'Privacy Policy', href: `${APP_URL}/privacy` },
  ],
};

const social = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/company/quickruit-in', icon: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>' },
  { label: 'X', href: 'https://x.com/quickruitAI', icon: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H2.33l7.73-8.84L1.9 2.25h6.83l4.71 6.23 5.46-6.23Zm-1.16 17.52h1.83L7.73 4.13H5.9l11.84 15.64Z"/></svg>' },
  { label: 'Instagram', href: 'https://www.instagram.com/quickruit.in', icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none"/></svg>' },
  { label: 'YouTube', href: 'https://www.youtube.com/@QuickRuit', icon: '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.12C19.55 3.5 12 3.5 12 3.5s-7.55 0-9.4.58A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.12c1.85.58 9.4.58 9.4.58s7.55 0 9.4-.58a3 3 0 0 0 2.1-2.12A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.55 15.6V8.4L15.82 12l-6.27 3.6Z"/></svg>' },
];

const tickerPhrases = ['HIRE SMARTER', 'EVALUATE FAIRLY', 'SCALE FAST', 'HIRE INTELLIGENCE'];
---

<footer class="relative overflow-hidden bg-primary text-white">
  <div class="pointer-events-none absolute -right-28 -top-28 h-72 w-72 rounded-full border border-white/10"></div>
  <div class="pointer-events-none absolute right-10 top-16 h-40 w-40 rounded-full border border-white/10"></div>

  <div class="relative mx-auto max-w-7xl px-5 pb-14 pt-16 sm:px-6 lg:px-8 lg:pb-16 lg:pt-20">
    <div class="grid gap-14 lg:grid-cols-[minmax(280px,1.05fr)_1.6fr] lg:gap-24">
      <div class="max-w-md">
        <a href="/" class="group inline-flex items-center gap-2.5 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary" aria-label="QuickRuit home">
          <span class="flex h-9 w-9 items-center justify-center rounded-[11px] bg-white/15 ring-1 ring-white/20 transition-transform duration-200 group-hover:-rotate-3 group-hover:scale-105">
            <svg width="20" height="20" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 2L15.5 5.5V12.5L9 16L2.5 12.5V5.5L9 2Z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/><circle cx="9" cy="9" r="2.5" fill="white"/></svg>
          </span>
          <span class="text-2xl font-black tracking-[-0.05em]">QuickRuit</span>
          <span class="rounded-md border border-white/30 bg-white/15 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.16em]">Beta</span>
        </a>
        <p class="mt-7 max-w-sm text-base font-medium leading-7 text-white/75 sm:text-lg">Automate your entire first round of hiring. Screen, interview, and rank candidates on autopilot.</p>
        <a href={`${APP_URL}/book-demo`} class="mt-8 inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-sm font-bold text-primary shadow-lg transition-all hover:-translate-y-0.5 hover:bg-surface active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"><span aria-hidden="true">▶</span> Book Demo</a>
      </div>

      <div class="grid grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3 sm:gap-x-10">
        {Object.entries(links).map(([group, items]) => (
          <div class={group === 'Legal' ? 'col-span-2 sm:col-span-1' : ''}>
            <h2 class="mb-5 inline-block border-b border-white/25 pb-2 text-[11px] font-bold uppercase tracking-[0.18em] text-white/90">{group}</h2>
            <ul class="space-y-3.5">
              {items.map((item) => <li><a href={item.href} class="text-sm font-medium text-white/65 transition-all hover:translate-x-1 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white">{item.label}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="relative overflow-hidden bg-white py-4 text-on-surface" aria-label="QuickRuit values">
    <div class="flex w-max animate-marquee whitespace-nowrap motion-reduce:animate-none">
      {[...tickerPhrases, ...tickerPhrases].map((phrase, index) => <div class="flex items-center px-5 sm:px-7" aria-hidden={index >= tickerPhrases.length ? 'true' : undefined}><span class="text-xs font-black uppercase tracking-[0.18em] sm:text-sm">{phrase}</span><span class="ml-5 text-primary sm:ml-7" aria-hidden="true">•</span><span class="ml-5 text-xs font-black uppercase tracking-[0.18em] text-primary sm:ml-7 sm:text-sm">QUICKRUIT</span></div>)}
    </div>
  </div>

  <div class="relative border-t border-white/15 bg-primary-dark/30">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-5 py-6 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <div class="flex flex-col gap-2 text-center text-[11px] font-semibold uppercase tracking-[0.08em] text-white/55 md:flex-row md:items-center md:gap-6 md:text-left"><span>© {new Date().getFullYear()} QuickRuit. All rights reserved.</span><span class="hidden h-1 w-1 rounded-full bg-white/35 md:block"></span><span>Built for faster, fairer hiring.</span></div>
      <div class="flex items-center justify-center gap-3">
        <div class="flex items-center gap-2">{social.map((item) => <a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label} class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-white/75 transition-all hover:-translate-y-0.5 hover:bg-white hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white"><span class="h-4 w-4" set:html={item.icon}></span></a>)}</div>
        <button id="back-to-top" type="button" class="ml-2 flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-white/10 text-white transition-all hover:-translate-y-0.5 hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white" aria-label="Back to top"><svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m3 10 5-5 5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('back-to-top')?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
</script>
