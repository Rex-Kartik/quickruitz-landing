---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';

const links = {
  Product: [
    { label: 'Aptitude Assessment', href: '#features' },
    { label: 'Adaptive Technical', href: '#features' },
    { label: 'AI Video Interview', href: '#features' },
    { label: 'Coding Assessment', href: '#features' },
    { label: 'Candidate Intelligence', href: '#intelligence' },
    { label: 'Bulk Screening', href: '#features' },
  ],
  Solutions: [
    { label: 'Corporate HR', href: '#solutions' },
    { label: 'Campus Placement', href: '#solutions' },
    { label: 'Staffing Agencies', href: '#solutions' },
  ],
  Resources: [
    { label: 'Blog', href: `${APP_URL}/blogs` },
    { label: 'Documentation', href: '#' },
    { label: 'Changelog', href: '#' },
    { label: 'API', href: '#' },
  ],
  Company: [
    { label: 'About', href: '#' },
    { label: 'Pricing', href: '#pricing' },
    { label: 'Book Demo', href: `${APP_URL}/book-demo` },
    { label: 'Contact', href: '#' },
  ],
  Legal: [
    { label: 'Privacy Policy', href: '#' },
    { label: 'Terms of Service', href: '#' },
    { label: 'Security', href: '#' },
    { label: 'AI Ethics', href: '#' },
  ],
};

const social = [
  {
    label: 'LinkedIn',
    href: 'https://linkedin.com/company/quickruit',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
  },
  {
    label: 'Twitter',
    href: 'https://twitter.com/quickruit',
    icon: `<svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>`,
  },
];
---

<footer class="bg-navy pt-16 pb-8">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Main grid -->
    <div class="mb-12 grid grid-cols-2 gap-8 md:grid-cols-3 lg:grid-cols-6">
      <!-- Brand column -->
      <div class="col-span-2 md:col-span-3 lg:col-span-1">
        <a href="/" class="mb-5 flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary">
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
              <path d="M9 2L15.5 5.5V12.5L9 16L2.5 12.5V5.5L9 2Z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="9" cy="9" r="2.5" fill="white"/>
            </svg>
          </div>
          <span class="text-lg font-black text-white">QuickRuit</span>
        </a>
        <p class="mb-5 text-xs font-medium leading-relaxed text-white/40">
          Evidence-based hiring for modern teams. Assess. Adapt. Decide.
        </p>
        <div class="flex gap-3">
          {social.map(s => (
            <a
              href={s.href}
              class="flex h-8 w-8 items-center justify-center rounded-lg bg-white/8 text-white/40 transition-colors hover:bg-white/15 hover:text-white"
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="h-4 w-4" set:html={s.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Link columns -->
      {Object.entries(links).map(([group, items]) => (
        <div>
          <h4 class="mb-4 text-[10px] font-bold uppercase tracking-widest text-white/30">{group}</h4>
          <ul class="space-y-2.5">
            {items.map(item => (
              <li>
                <a href={item.href} class="text-sm font-medium text-white/50 transition-colors hover:text-white">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom bar -->
    <div class="border-t border-white/8 pt-8">
      <div class="flex flex-col items-start justify-between gap-5 sm:flex-row sm:items-center">
        <p class="text-xs font-medium text-white/30">
          © 2026 QuickRuit Technologies Pvt. Ltd. All rights reserved. Built for India's fastest-growing teams.
        </p>
        <!-- Trust badges -->
        <div class="flex flex-wrap gap-3">
          {['AI Ethics', 'Secure', 'Privacy-First', 'Bias-Aware'].map(badge => (
            <span class="flex items-center gap-1.5 rounded-pill border border-white/10 px-3 py-1 text-[10px] font-semibold text-white/30">
              <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
              {badge}
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
