---
<section class="border-y border-border bg-surface-low py-12">
  <div class="mx-auto max-w-7xl px-6">
    <p class="mb-8 text-center text-xs font-bold uppercase tracking-widest text-on-surface-muted">
      Trusted by 2,000+ recruiters, HR teams & campus placement cells
    </p>
    <div class="flex flex-wrap items-center justify-center gap-x-12 gap-y-6 opacity-50 grayscale">
      {[
        "TechCorp", "HireZen", "Startup Hub", "GlobalRecruits",
        "CampusConnect", "TalentForge", "ScaleTeam"
      ].map(logo => (
        <div class="flex items-center gap-2">
          <div class="h-8 w-8 rounded bg-on-surface/20"></div>
          <span class="text-sm font-bold text-on-surface">{logo}</span>
        </div>
      ))}
    </div>
  </div>
</section>
