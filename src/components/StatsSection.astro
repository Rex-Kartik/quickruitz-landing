---
// Stats reflect validated-pilot figures only — no fabricated data
const stats = [
  {
    number: '40+',
    label: 'HR pros validated',
    sub: 'professionals who helped shape QuickRuit\'s assessment model through structured discovery interviews',
    qualified: true,
  },
  {
    number: '70%',
    label: 'Screening time saved',
    sub: 'projected reduction in time-to-shortlist based on pilot testing and workflow analysis',
    qualified: true,
  },
  {
    number: '< 4hrs',
    label: 'From application to shortlist',
    sub: 'typical time to generate a ranked candidate list once assessments are completed',
    qualified: false,
  },
  {
    number: '₹99',
    label: 'Per AI interview',
    sub: 'transparent, pay-as-you-grow credit pricing — no lock-ins, no minimums beyond the free pilot',
    qualified: false,
  },
];

const badges = [
  { label: 'DPDPA Compliant', icon: '🛡️' },
  { label: 'Secure Assessments', icon: '🔒' },
  { label: 'Bias-Aware Evaluation', icon: '⚖️' },
  { label: 'Candidate Consent First', icon: '🤝' },
];
---

<section class="bg-white py-24">
  <div class="mx-auto max-w-7xl px-6">

    <!-- Header -->
    <div class="mb-16 text-center">
      <span class="mb-4 inline-block rounded-pill border border-border bg-surface px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-on-surface-muted">
        Early Traction
      </span>
      <h2 class="text-[40px] sm:text-[48px] font-black leading-[1.1] tracking-tight text-on-surface">
        Built with real hiring teams.
      </h2>
      <p class="mx-auto mt-5 max-w-lg text-lg font-medium text-on-surface-muted">
        QuickRuit is in active pilot. These numbers reflect what we've validated — not what we're projecting.
      </p>
    </div>

    <!-- Stats grid -->
    <div class="mb-16 grid grid-cols-2 gap-5 lg:grid-cols-4">
      {stats.map(s => (
        <div class="group rounded-2xl border border-border bg-surface p-8 text-center transition-all hover:-translate-y-1 hover:border-primary/20 hover:shadow-card hover:bg-surface-blue">
          <div class="mb-2 text-[52px] font-black leading-none tracking-tight text-primary">{s.number}</div>
          <div class="mb-2 text-sm font-black text-on-surface">{s.label}</div>
          <p class="text-xs font-medium leading-relaxed text-on-surface-muted">{s.sub}</p>
          {s.qualified && (
            <p class="mt-3 text-[9px] font-bold uppercase tracking-widest text-on-surface-muted/40">Pilot validated</p>
          )}
        </div>
      ))}
    </div>

    <!-- Trust / compliance badges -->
    <div class="flex flex-wrap items-center justify-center gap-4">
      {badges.map(b => (
        <div class="flex items-center gap-2.5 rounded-pill border border-border bg-surface px-5 py-2.5">
          <span class="text-base">{b.icon}</span>
          <span class="text-sm font-semibold text-on-surface-muted">{b.label}</span>
        </div>
      ))}
    </div>

    <!-- Honest footnote -->
    <p class="mt-6 text-center text-xs font-medium text-on-surface-muted/60">
      QuickRuit is in active pilot. Figures marked "pilot validated" are from structured validation conversations with HR professionals. Projected metrics are based on workflow analysis.
    </p>
  </div>
</section>
