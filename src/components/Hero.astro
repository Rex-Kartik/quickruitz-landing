<script>
  // Hero tab switching
  const tabs = document.querySelectorAll<HTMLButtonElement>('.hero-tab');
  const panels = document.querySelectorAll<HTMLElement>('.hero-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const targetId = tab.dataset.tab;

      // Update tab styles
      tabs.forEach(t => {
        const isActive = t.dataset.tab === targetId;
        t.className = t.className.replace(/bg-primary text-white shadow-sm|bg-surface text-on-surface-muted hover:bg-surface-blue hover:text-primary border border-border/g, '');
        if (isActive) {
          t.classList.add('bg-primary', 'text-white', 'shadow-sm');
          t.classList.remove('bg-surface', 'text-on-surface-muted', 'hover:bg-surface-blue', 'hover:text-primary', 'border', 'border-border');
        } else {
          t.classList.add('bg-surface', 'text-on-surface-muted', 'hover:bg-surface-blue', 'hover:text-primary', 'border', 'border-border');
          t.classList.remove('bg-primary', 'text-white', 'shadow-sm');
        }
        t.setAttribute('aria-selected', String(isActive));
      });

      // Show/hide panels
      panels.forEach(panel => {
        if (panel.id === `panel-${targetId}`) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    });
  });
</script>
