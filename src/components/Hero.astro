---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';
---

<section class="relative overflow-hidden bg-white pb-0 pt-10 sm:pt-12 lg:pt-16" id="hero">

  <div class="relative mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl text-center">
      <!-- Headline -->
      <div class="text-center mb-6 mt-4 motion-safe:animate-fade-up">
        <h1 class="mx-auto max-w-[1200px] text-[32px] sm:text-[40px] md:text-[44px] lg:text-[46px] xl:text-[50px] font-medium leading-[1.25] tracking-tight text-[#1f2937]">
          <span class="block">Resumes don't predict <span class="text-primary">success.</span></span>
          <span class="block mt-1 whitespace-normal lg:whitespace-nowrap">Hire based on the true <span class="text-primary">skills</span> that do.</span>
        </h1>
      </div>

      <!-- Subheading -->
      <p class="mx-auto mb-8 max-w-[1100px] text-center text-[20px] sm:text-[22px] lg:text-[24px] font-medium leading-[1.6] text-[#4d566b] motion-safe:animate-fade-up" style="animation-delay:140ms">
        Get clear, evidence-backed insight into every candidate’s skills and performance — so your team can shortlist with confidence, spend less time screening, and focus on the people worth talking to.
      </p>

      <!-- Value bullets -->
      <div class="mx-auto mt-7 flex max-w-3xl flex-wrap justify-center gap-x-7 gap-y-3 text-[13px] font-semibold text-on-surface-muted motion-safe:animate-fade-up" style="animation-delay:190ms">
        {[
          { label: 'Save 70% screening time', icon: '⚡' },
          { label: 'Build hiring evidence', icon: '🎯' },
          { label: 'Hire with confidence', icon: '✅' },
        ].map((item) => <span class="inline-flex items-center gap-2"><span aria-hidden="true">{item.icon}</span>{item.label}</span>)}
      </div>

      <!-- CTAs -->
      <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row motion-safe:animate-fade-up" style="animation-delay:240ms">
        <a href={`${APP_URL}/employer/signup`} class="inline-flex min-w-[180px] items-center justify-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-[17px] font-semibold text-white transition-all duration-200 hover:bg-primary-dark hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">Get Started</a>
        <a href={`${APP_URL}/book-demo`} class="inline-flex min-w-[220px] items-center justify-center gap-2 rounded-lg bg-primary px-8 py-3.5 text-[17px] font-semibold text-white transition-all duration-200 hover:bg-primary-dark hover:-translate-y-0.5 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">Find Your Subscription</a>
      </div>

      <p class="mt-4 text-[11px] font-medium text-on-surface-muted/80 motion-safe:animate-fade-up" style="animation-delay:290ms">Free pilot · 20 credits included · No credit card required</p>
      <p class="mx-auto mt-12 max-w-4xl text-xs font-semibold leading-6 text-on-surface-muted/75 motion-safe:animate-fade-up sm:text-sm" style="animation-delay:330ms">Built for startups, scaleups, HR recruiters, TA teams, staffing &amp; recruiting agencies, universities</p>

      <!-- Product capability selector -->
      <div id="hero-tabs" class="mt-7 flex flex-wrap justify-center gap-1.5 px-2 motion-safe:animate-fade-up" style="animation-delay:370ms" role="tablist" aria-label="QuickRuit product capabilities">
        {[
          { id: 'aptitude', label: 'Aptitude' },
          { id: 'adaptive', label: 'Adaptive' },
          { id: 'interview', label: 'AI Interview', badge: 'BETA' },
          { id: 'coding', label: 'Coding' },
          { id: 'intelligence', label: 'Intelligence' },
        ].map((tab, i) => (
          <button type="button" role="tab" aria-selected={i === 0} class={`hero-tab relative rounded-full px-5 py-2.5 text-xs font-bold transition-all duration-200 ${i === 0 ? 'bg-primary text-white shadow-[0_8px_18px_rgba(0,82,255,0.18)]' : 'border border-border bg-white text-on-surface-muted hover:border-primary/25 hover:bg-surface-blue hover:text-primary'}`} data-tab={tab.id}>
            {tab.label}{tab.badge && <span class="ml-1.5 rounded bg-amber-100 px-1.5 py-0.5 text-[8px] font-bold uppercase tracking-[0.12em] text-amber-700">{tab.badge}</span>}
          </button>
        ))}
      </div>
      <div class="mt-4 flex items-center justify-center gap-2 text-[10px] font-bold uppercase tracking-[0.16em] text-on-surface-muted/60"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>Live product preview <span class="text-border">/</span> One workflow, every signal connected</div>
    </div>
  </div>

  <!-- Product Mockup (full width, below tabs) -->
  <div class="relative mt-6 mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-t-2xl border border-border border-b-0 bg-[#0c1526] shadow-[0_-8px_40px_rgba(0,0,0,0.15)] min-h-[460px] lg:min-h-[520px]">
      
      <!-- Browser chrome bar -->
      <div class="flex items-center gap-1.5 border-b border-white/10 bg-[#111d35] px-4 py-3">
        <div class="h-3 w-3 rounded-full bg-[#ff5f57]"></div>
        <div class="h-3 w-3 rounded-full bg-[#febc2e]"></div>
        <div class="h-3 w-3 rounded-full bg-[#28c840]"></div>
        <div class="ml-4 flex items-center gap-2 flex-1 rounded-md bg-white/8 px-3 py-1.5 text-xs text-white/40">
          <svg class="h-3 w-3" viewBox="0 0 12 12" fill="none"><rect x="1" y="1" width="10" height="10" rx="2" stroke="currentColor" stroke-width="1"/><path d="M4 6h4M6 4v4" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
          app.quickruit.in/employer/dashboard
        </div>
      </div>

      <!-- Tab Panels -->

      <!-- APTITUDE PANEL -->
      <div id="panel-aptitude" class="hero-panel p-5 lg:p-8">
        <div class="grid grid-cols-12 gap-4 h-full">
          <!-- Left sidebar -->
          <div class="col-span-3 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-3">
              <p class="mb-2.5 text-[9px] font-bold uppercase tracking-widest text-white/40">Active Jobs</p>
              {['Frontend Eng', 'Product Designer', 'Data Analyst', 'Backend Eng'].map((j, i) => (
                <div class={`mb-1.5 flex items-center justify-between rounded-lg px-2 py-1.5 ${i === 0 ? 'bg-primary/20 border border-primary/30' : 'bg-white/5'}`}>
                  <span class={`text-[11px] font-medium ${i === 0 ? 'text-white' : 'text-white/60'}`}>{j}</span>
                  {i === 0 && <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>}
                </div>
              ))}
            </div>
            <div class="rounded-xl bg-white/5 p-3">
              <p class="mb-2 text-[9px] font-bold uppercase tracking-widest text-white/40">Drive Stats</p>
              {[['Invited', '124'], ['Completed', '89'], ['Shortlisted', '12']].map(([l, v]) => (
                <div class="mb-1.5 flex justify-between">
                  <span class="text-[10px] text-white/50">{l}</span>
                  <span class="text-[10px] font-bold text-white">{v}</span>
                </div>
              ))}
            </div>
          </div>
          <!-- Main area -->
          <div class="col-span-9 flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs font-bold text-white">Aptitude Assessment — Frontend Engineer</p>
                <p class="text-[10px] text-white/40">89 candidates completed · Avg score: 67%</p>
              </div>
              <span class="rounded-pill bg-emerald-500/20 border border-emerald-500/30 px-3 py-1 text-[10px] font-bold text-emerald-400">LIVE</span>
            </div>
            <!-- Score distribution bar -->
            <div class="rounded-xl bg-white/5 p-4">
              <p class="mb-3 text-[10px] font-bold uppercase tracking-widest text-white/40">Score Distribution</p>
              <div class="flex items-end gap-1.5 h-20">
                {[12, 28, 45, 67, 89, 72, 54, 38, 21, 8].map((h) => (
                  <div
                    class="flex-1 rounded-t-sm bg-primary/60 transition-all hover:bg-primary"
                    style={`height: ${h}%`}
                  ></div>
                ))}
              </div>
              <div class="mt-2 flex justify-between text-[9px] text-white/30">
                <span>0%</span><span>50%</span><span>100%</span>
              </div>
            </div>
            <!-- Top candidates -->
            <div class="grid grid-cols-3 gap-2">
              {[
                { name: 'Priya S.', score: 94, tag: 'Top Match', color: 'text-emerald-400' },
                { name: 'Rahul G.', score: 88, tag: 'Strong', color: 'text-blue-400' },
                { name: 'Anita P.', score: 82, tag: 'Good', color: 'text-indigo-400' },
              ].map(c => (
                <div class="rounded-xl bg-white/5 p-3 text-center">
                  <div class="mx-auto mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-gradient-to-br from-primary to-blue-700 text-xs font-black text-white">
                    {c.name[0]}
                  </div>
                  <p class="text-[11px] font-semibold text-white">{c.name}</p>
                  <p class={`text-base font-black ${c.color}`}>{c.score}%</p>
                  <p class="text-[9px] text-white/40">{c.tag}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- ADAPTIVE PANEL -->
      <div id="panel-adaptive" class="hero-panel hidden p-5 lg:p-8">
        <div class="grid grid-cols-12 gap-4">
          <div class="col-span-4 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-4">
              <p class="mb-1 text-[10px] font-bold uppercase tracking-widest text-white/40">Candidate</p>
              <div class="flex items-center gap-2 mb-3">
                <div class="h-8 w-8 rounded-full bg-gradient-to-br from-violet-400 to-blue-600 flex items-center justify-center text-xs font-black text-white">A</div>
                <div>
                  <p class="text-sm font-semibold text-white">Arjun Mehta</p>
                  <p class="text-[10px] text-white/40">Backend Engineer</p>
                </div>
              </div>
              <div class="space-y-2">
                <p class="text-[10px] font-bold text-white/40 uppercase tracking-wider">Current Difficulty</p>
                <div class="flex items-center gap-2">
                  <div class="flex-1 flex gap-1">
                    {[1,2,3,4,5,6].map((_, i) => (
                      <div class={`h-2 flex-1 rounded-sm ${i < 4 ? 'bg-amber-400' : 'bg-white/10'}`}></div>
                    ))}
                  </div>
                  <span class="text-xs font-bold text-amber-400">Hard</span>
                </div>
                <p class="text-[10px] text-white/30">Increased after Q3 (scored 88%)</p>
              </div>
            </div>
            <div class="rounded-xl bg-white/5 p-4">
              <p class="mb-2 text-[10px] font-bold uppercase tracking-widest text-white/40">Performance Trail</p>
              {[
                { q: 'Q1', d: 'Medium', s: '76%', up: false },
                { q: 'Q2', d: 'Medium', s: '83%', up: false },
                { q: 'Q3', d: 'Hard ↑', s: '88%', up: true },
                { q: 'Q4', d: 'Hard', s: '—', up: false },
              ].map(row => (
                <div class={`mb-1.5 flex items-center gap-2 rounded-lg px-2 py-1.5 ${row.up ? 'bg-primary/15' : 'bg-white/3'}`}>
                  <span class="text-[10px] font-bold text-white/50 w-5">{row.q}</span>
                  <span class={`text-[10px] font-semibold flex-1 ${row.up ? 'text-primary' : 'text-white/60'}`}>{row.d}</span>
                  <span class="text-[10px] font-bold text-white">{row.s}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="col-span-8 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-4">
              <div class="flex items-start justify-between mb-3">
                <div>
                  <span class="text-[9px] font-bold uppercase tracking-widest text-amber-400">Question 4 · Hard</span>
                  <p class="text-sm font-semibold text-white mt-1">Design a rate limiter that handles 10,000 requests/second with sliding window algorithm. What data structure would you use and why?</p>
                </div>
                <div class="ml-4 flex-shrink-0 rounded-lg bg-amber-500/20 border border-amber-500/30 px-2.5 py-1.5 text-center">
                  <p class="text-[9px] text-amber-400 font-bold">Time Left</p>
                  <p class="text-lg font-black text-white">4:23</p>
                </div>
              </div>
              <!-- MCQ options -->
              <div class="space-y-2">
                {[
                  { opt: 'A', text: 'Hash map with TTL-based expiry and circular buffer', selected: true },
                  { opt: 'B', text: 'Simple array with timestamps', selected: false },
                  { opt: 'C', text: 'Redis sorted sets with timestamps as scores', selected: false },
                  { opt: 'D', text: 'Priority queue ordered by request time', selected: false },
                ].map(o => (
                  <div class={`flex items-start gap-3 rounded-xl p-3 cursor-pointer transition-all ${o.selected ? 'bg-primary/20 border border-primary/40' : 'bg-white/5 hover:bg-white/8'}`}>
                    <div class={`flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-black mt-0.5 ${o.selected ? 'bg-primary text-white' : 'bg-white/10 text-white/50'}`}>{o.opt}</div>
                    <p class={`text-xs ${o.selected ? 'text-white font-semibold' : 'text-white/60'}`}>{o.text}</p>
                  </div>
                ))}
              </div>
            </div>
            <div class="flex items-center gap-3 rounded-xl bg-primary/10 border border-primary/20 p-3">
              <div class="h-2 w-2 rounded-full bg-primary animate-pulse"></div>
              <p class="text-[11px] font-semibold text-primary">AI Adaptive Engine: Difficulty will increase to <strong>Expert</strong> if next answer is correct</p>
            </div>
          </div>
        </div>
      </div>

      <!-- AI INTERVIEW PANEL -->
      <div id="panel-interview" class="hero-panel hidden p-5 lg:p-8">
        <div class="grid grid-cols-12 gap-4">
          <div class="col-span-4 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-4 text-center">
              <!-- Video frame placeholder -->
              <div class="mx-auto mb-3 flex h-28 w-28 items-center justify-center rounded-2xl bg-gradient-to-br from-slate-700 to-slate-900 border border-white/10">
                <svg class="h-10 w-10 text-white/30" viewBox="0 0 24 24" fill="none">
                  <path d="M15 10l4.553-2.277A1 1 0 0121 8.72v6.56a1 1 0 01-1.447.9L15 14v-4z" stroke="currentColor" stroke-width="1.5"/>
                  <rect x="3" y="7" width="12" height="10" rx="2" stroke="currentColor" stroke-width="1.5"/>
                </svg>
              </div>
              <p class="text-sm font-semibold text-white">Priya Sharma</p>
              <p class="text-[10px] text-white/40 mb-2">Product Manager Candidate</p>
              <span class="inline-flex items-center gap-1.5 rounded-pill bg-red-500/20 border border-red-500/30 px-3 py-1 text-[9px] font-bold text-red-400">
                <span class="h-1.5 w-1.5 rounded-full bg-red-400 animate-pulse"></span>
                REC
              </span>
            </div>
            <div class="rounded-xl bg-white/5 p-4">
              <p class="mb-2 text-[10px] font-bold uppercase tracking-widest text-white/40">Live AI Signals</p>
              {[
                { label: 'Confidence', val: 82 },
                { label: 'Clarity', val: 76 },
                { label: 'Relevance', val: 91 },
              ].map(s => (
                <div class="mb-2">
                  <div class="mb-1 flex justify-between text-[10px]">
                    <span class="text-white/50">{s.label}</span>
                    <span class="font-bold text-white">{s.val}%</span>
                  </div>
                  <div class="h-1.5 overflow-hidden rounded-full bg-white/10">
                    <div class="h-full rounded-full bg-primary transition-all" style={`width:${s.val}%`}></div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="col-span-8 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-4">
              <p class="mb-3 text-[10px] font-bold uppercase tracking-widest text-white/40">AI Interviewer</p>
              <div class="space-y-3">
                <div class="flex gap-3">
                  <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-primary text-[10px] font-black text-white">Q</div>
                  <div class="rounded-xl rounded-tl-sm bg-primary/15 border border-primary/20 p-3 flex-1">
                    <p class="text-xs text-white/90">Tell me about a time when you had to make a product decision with incomplete data. What was your approach?</p>
                  </div>
                </div>
                <div class="flex gap-3 justify-end">
                  <div class="rounded-xl rounded-tr-sm bg-white/10 p-3 max-w-[80%]">
                    <p class="text-xs text-white/70">In my previous role at Zomato, we had a 2-day window to decide on a feature rollout with only 40% of our usual data...</p>
                  </div>
                  <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-violet-400 to-blue-500 text-[10px] font-black text-white">P</div>
                </div>
                <div class="flex gap-3">
                  <div class="flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full bg-primary text-[10px] font-black text-white">Q</div>
                  <div class="rounded-xl rounded-tl-sm bg-primary/15 border border-primary/20 p-3 flex-1">
                    <p class="text-xs text-white/90">Interesting. What frameworks did you use to structure that decision? Did you involve stakeholders?</p>
                    <p class="mt-1 text-[9px] text-primary/70">↳ AI follow-up based on response</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-amber-500/10 border border-amber-500/20 p-3">
              <span class="text-sm">⚠️</span>
              <p class="text-[11px] text-amber-300/90 font-medium">AI Video Interview is currently in Beta. Capabilities are evolving.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- CODING PANEL -->
      <div id="panel-coding" class="hero-panel hidden p-5 lg:p-8">
        <div class="grid grid-cols-12 gap-4">
          <div class="col-span-5 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-4">
              <div class="flex items-center justify-between mb-3">
                <p class="text-[10px] font-bold uppercase tracking-widest text-white/40">Problem</p>
                <span class="rounded-pill bg-amber-500/20 px-2 py-0.5 text-[9px] font-bold text-amber-400">Medium</span>
              </div>
              <p class="text-sm font-semibold text-white mb-2">Two Sum</p>
              <p class="text-xs text-white/60 leading-relaxed">Given an array of integers and a target, return indices of the two numbers that add up to target. Each input has exactly one solution.</p>
              <div class="mt-3 rounded-lg bg-white/5 p-2.5">
                <p class="text-[9px] font-bold text-white/30 mb-1">EXAMPLE</p>
                <p class="text-[11px] text-emerald-400 font-mono">Input: [2,7,11,15], target=9</p>
                <p class="text-[11px] text-white/60 font-mono">Output: [0,1]</p>
              </div>
            </div>
            <div class="rounded-xl bg-white/5 p-4">
              <p class="mb-2 text-[10px] font-bold uppercase tracking-widest text-white/40">Test Cases</p>
              {[
                { label: 'Test 1', status: 'pass' },
                { label: 'Test 2', status: 'pass' },
                { label: 'Test 3', status: 'fail' },
                { label: 'Test 4', status: 'pending' },
              ].map(t => (
                <div class="mb-1.5 flex items-center gap-2">
                  <div class={`h-4 w-4 rounded-full flex items-center justify-center text-[8px] ${t.status === 'pass' ? 'bg-emerald-500/20 text-emerald-400' : t.status === 'fail' ? 'bg-red-500/20 text-red-400' : 'bg-white/10 text-white/30'}`}>
                    {t.status === 'pass' ? '✓' : t.status === 'fail' ? '✗' : '·'}
                  </div>
                  <span class={`text-[11px] font-medium ${t.status === 'pass' ? 'text-emerald-400' : t.status === 'fail' ? 'text-red-400' : 'text-white/30'}`}>{t.label}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="col-span-7 flex flex-col gap-3">
            <!-- Code editor -->
            <div class="rounded-xl bg-[#0a1628] border border-white/10 overflow-hidden flex-1">
              <div class="flex items-center justify-between border-b border-white/10 px-3 py-2">
                <div class="flex gap-2 text-[10px]">
                  {['Python', 'JavaScript', 'Java', 'C++'].map((lang, i) => (
                    <span class={`px-2 py-0.5 rounded font-bold ${i === 0 ? 'bg-primary/30 text-primary' : 'text-white/30 hover:text-white/60'}`}>{lang}</span>
                  ))}
                </div>
                <span class="text-[9px] text-white/30">■ Proctoring Active</span>
              </div>
              <div class="p-3 font-mono text-[11px] leading-relaxed">
                <p><span class="text-purple-400">def</span> <span class="text-blue-300">two_sum</span><span class="text-white/80">(nums, target):</span></p>
                <p class="pl-4"><span class="text-purple-400">    seen</span> <span class="text-white/80">= {}</span></p>
                <p class="pl-4"><span class="text-blue-300">    for</span> <span class="text-white/80">i, num</span> <span class="text-blue-300">in</span> <span class="text-emerald-400">enumerate</span><span class="text-white/80">(nums):</span></p>
                <p class="pl-8"><span class="text-white/80">comp = target - num</span></p>
                <p class="pl-8"><span class="text-blue-300">if</span> <span class="text-white/80">comp</span> <span class="text-blue-300">in</span> <span class="text-purple-400">seen</span><span class="text-white/80">:</span></p>
                <p class="pl-12"><span class="text-blue-300">return</span> <span class="text-white/80">[seen[comp], i]</span></p>
                <p class="pl-8"><span class="text-purple-400">seen</span><span class="text-white/80">[num] = i</span></p>
                <p class="flex items-center gap-1"><span class="inline-block h-3.5 w-0.5 bg-white/70 animate-pulse ml-0.5"></span></p>
              </div>
            </div>
            <div class="flex items-center gap-2 rounded-xl bg-emerald-500/10 border border-emerald-500/20 p-3">
              <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <p class="text-[11px] font-semibold text-emerald-400">2/3 test cases passing · O(n) complexity detected</p>
            </div>
          </div>
        </div>
      </div>

      <!-- INTELLIGENCE PANEL -->
      <div id="panel-intelligence" class="hero-panel hidden p-5 lg:p-8">
        <div class="grid grid-cols-12 gap-4">
          <div class="col-span-4 flex flex-col gap-3">
            <div class="rounded-xl bg-white/5 p-4">
              <div class="flex items-center gap-3 mb-4">
                <div class="h-10 w-10 rounded-full bg-gradient-to-br from-primary to-blue-700 flex items-center justify-center text-sm font-black text-white">P</div>
                <div>
                  <p class="text-sm font-black text-white">Priya Sharma</p>
