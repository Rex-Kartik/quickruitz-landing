---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';
---

<section class="relative overflow-hidden py-28" style="background: linear-gradient(135deg, #0052FF 0%, #003ec7 60%, #002a8a 100%);">
  <!-- Atmospheric overlays -->
  <div class="pointer-events-none absolute -top-20 left-1/4 h-[400px] w-[400px] rounded-full bg-white/5 blur-[80px]"></div>
  <div class="pointer-events-none absolute -bottom-20 right-1/4 h-[300px] w-[300px] rounded-full bg-white/5 blur-[60px]"></div>
  <!-- Subtle grain -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E&quot;); background-size: 200px;"></div>

  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <h2 class="mb-5 text-[40px] sm:text-[52px] font-black leading-[1.08] tracking-tight text-white">
      Your next great hire is in your<br />
      next assessment.
    </h2>
    <p class="mb-10 text-lg font-medium text-white/70">
      Start evaluating candidates on real skills today. Free 20-credit pilot, no credit card required.
    </p>

    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={`${APP_URL}/employer/signup`}
        class="inline-flex items-center gap-2 rounded-pill bg-white px-8 py-4 text-sm font-bold text-primary shadow-lg hover:bg-white/90 hover:-translate-y-0.5 transition-all active:scale-[0.97]"
      >
        Start Free Pilot
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
      <a
        href={`${APP_URL}/book-demo`}
        class="inline-flex items-center gap-2 rounded-pill border border-white/25 px-8 py-4 text-sm font-bold text-white hover:bg-white/10 hover:-translate-y-0.5 transition-all"
      >
        Book a Demo
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none"><rect x="2" y="3" width="12" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/><path d="M5 2v2M11 2v2M2 7h12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </a>
    </div>

    <p class="mt-6 text-xs font-medium text-white/50">
      Free pilot · 20 assessment credits · No credit card · Cancel anytime
    </p>

    <!-- Trust row -->
    <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {['AI Ethics Commitment', 'Secure Assessments', 'Bias-Aware Scoring', 'Data Privacy First'].map(t => (
        <div class="flex items-center gap-1.5 text-xs font-semibold text-white/50">
          <svg class="h-3.5 w-3.5 text-white/30" viewBox="0 0 14 14" fill="none">
            <path d="M2.5 7l3 3 6-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          {t}
        </div>
      ))}
    </div>
  </div>
</section>
