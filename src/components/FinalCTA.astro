---
// APP_URL: where the React SPA lives
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';
---
<section class="relative overflow-hidden bg-primary py-24">
  <!-- Background decoration -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute -top-40 left-1/2 h-[400px] w-[400px] -translate-x-1/2 rounded-full bg-white/5 blur-3xl"></div>
    <div class="absolute -bottom-20 right-0 h-[300px] w-[300px] rounded-full bg-white/5 blur-3xl"></div>
  </div>

  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <h2 class="mb-4 text-4xl font-black tracking-tight text-white sm:text-5xl">
      Ready to save 70% of your screening time?
    </h2>
    <p class="mb-10 text-lg font-medium text-white/80">
      Join 2,000+ teams who have automated their first-round hiring with QuickRuit.
    </p>
    <form
      class="mx-auto flex max-w-md flex-col gap-3 sm:flex-row"
      action={`${APP_URL}/employer/signup`}
      method="GET"
    >
      <input
        type="email"
        name="email"
        placeholder="Enter work email"
        class="flex-1 rounded-lg border border-white/20 bg-white/10 px-4 py-3.5 text-sm text-white placeholder:text-white/50 outline-none backdrop-blur-sm transition focus:border-white focus:ring-2 focus:ring-white/20"
      />
      <button
        type="submit"
        class="whitespace-nowrap rounded-lg bg-white px-6 py-3.5 text-sm font-bold text-primary transition-all hover:bg-white/90 hover:shadow-lg active:scale-[0.98]"
      >
        Get Started Free
      </button>
    </form>
    <p class="mt-4 text-xs font-medium text-white/60">Free Pilot includes 20 credits. No credit card required.</p>
  </div>
</section>
