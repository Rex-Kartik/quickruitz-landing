---
const rawAppUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://www.quickruit.in';
const APP_URL = rawAppUrl.replace(/\/$/, '');
---

<!--
  FinalCTA: Light soft-blue panel.
  Does NOT compete with the dark navy CandidateIntelligence section above it.
  Color rhythm: dark navy → white/soft-blue → dark navy footer
-->
<section class="bg-[#f4f7ff] py-24 sm:py-32">
  <div class="mx-auto max-w-4xl px-6">

    <!-- Contained premium panel — not a full-bleed saturated background -->
    <div class="relative overflow-hidden rounded-3xl border border-[#dbe6ff] bg-white px-8 py-14 text-center shadow-[0_24px_80px_rgba(0,82,255,0.08)] sm:px-14 sm:py-16">

      <!-- Subtle blue glow behind content -->
      <div class="pointer-events-none absolute left-1/2 top-0 h-64 w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-primary/8 blur-[80px]"></div>

      <!-- Eyebrow -->
      <div class="relative mb-6 flex justify-center">
        <span class="inline-flex items-center gap-2 rounded-pill border border-primary/20 bg-primary/5 px-4 py-1.5 text-xs font-bold uppercase tracking-widest text-primary">
          <span class="h-1.5 w-1.5 animate-pulse-dot rounded-full bg-primary"></span>
          Free Pilot Open
        </span>
      </div>

      <!-- Headline — dark navy typography -->
      <h2 class="relative mb-4 text-[36px] font-black leading-[1.1] tracking-tight text-[#050d1a] sm:text-[48px]">
        Ready to see the<br />
        <span class="text-primary">evidence?</span>
      </h2>

      <!-- Sub -->
      <p class="relative mx-auto mb-10 max-w-lg text-base font-medium leading-relaxed text-on-surface-muted sm:text-lg">
        Start your first evaluation free. 20 AI interview credits, no credit card required. Your next shortlist arrives with proof.
      </p>

      <!-- CTAs -->
      <div class="relative flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href={`${APP_URL}/employer/signup`}
          class="inline-flex items-center gap-2 rounded-pill bg-primary px-8 py-3.5 text-sm font-bold text-white shadow-card-blue transition-all hover:bg-primary-dark hover:-translate-y-0.5 active:scale-[0.97]"
        >
          Start Free Pilot
          <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </a>
        <a
          href={`${APP_URL}/book-demo`}
          class="inline-flex items-center gap-2 rounded-pill border border-border px-8 py-3.5 text-sm font-bold text-on-surface transition-all hover:border-primary/30 hover:bg-surface-blue hover:-translate-y-0.5"
        >
          Book a Demo
        </a>
      </div>

      <!-- Micro-trust row -->
      <div class="relative mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {['20 free credits', 'No credit card', 'Results in hours', 'Cancel anytime'].map(t => (
          <span class="flex items-center gap-1.5 text-xs font-semibold text-on-surface-muted">
            <svg class="h-3 w-3 text-primary" viewBox="0 0 12 12" fill="none">
              <path d="M2 6l2.5 2.5 5.5-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            {t}
          </span>
        ))}
      </div>
    </div>
  </div>
</section>
