---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';

const productLinks = [
  { label: 'Aptitude Assessment', desc: 'Role-specific aptitude tests', href: '#features' },
  { label: 'Adaptive Technical', desc: 'Difficulty adapts to performance', href: '#features' },
  { label: 'AI Video Interview', desc: 'Async AI-evaluated interviews', href: '#features' },
  { label: 'Coding Assessment', desc: 'Browser IDE + DSA evaluation', href: '#features' },
  { label: 'Candidate Intelligence', desc: 'Scorecards, evidence & ranking', href: '#intelligence' },
  { label: 'Bulk Screening', desc: 'Resume match + outreach at scale', href: '#features' },
];
---

<header
  id="main-nav"
  class="sticky top-0 z-50 w-full transition-all duration-300"
  style="background: rgba(255,255,255,0.97); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid transparent;"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 h-[68px]">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 flex-shrink-0">
      <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-primary shadow-sm">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 2L15.5 5.5V12.5L9 16L2.5 12.5V5.5L9 2Z" stroke="white" stroke-width="1.5" stroke-linejoin="round"/>
          <circle cx="9" cy="9" r="2.5" fill="white"/>
        </svg>
      </div>
      <span class="text-[19px] font-black tracking-tight text-on-surface">QuickRuit</span>
      <span class="hidden rounded-md bg-primary/10 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-widest text-primary sm:inline">BETA</span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden lg:flex items-center gap-1">

      <!-- Product Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1 rounded-lg px-3.5 py-2 text-sm font-semibold text-on-surface-muted transition-colors hover:text-on-surface hover:bg-surface">
          Product
          <svg class="h-3.5 w-3.5 transition-transform group-hover:rotate-180" viewBox="0 0 12 12" fill="none">
            <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>

        <!-- Mega dropdown -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200">
          <div class="w-[480px] rounded-2xl border border-border bg-white p-5 shadow-card">
            <p class="mb-3 text-[10px] font-bold uppercase tracking-widest text-on-surface-muted">Assessment Modules</p>
            <div class="grid grid-cols-2 gap-1.5">
              {productLinks.map(link => (
                <a
                  href={link.href}
                  class="group/item flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-surface-blue"
                >
                  <div class="mt-0.5 flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-lg bg-primary/10">
                    <div class="h-2 w-2 rounded-full bg-primary"></div>
                  </div>
                  <div>
                    <div class="text-sm font-semibold text-on-surface group-hover/item:text-primary transition-colors">{link.label}</div>
                    <div class="text-xs text-on-surface-muted">{link.desc}</div>
                  </div>
                </a>
              ))}
            </div>
            <div class="mt-4 border-t border-border pt-4">
              <a href={`${APP_URL}/book-demo`} class="flex items-center gap-2 text-sm font-semibold text-primary hover:underline">
                See all modules in action →
              </a>
            </div>
          </div>
        </div>
      </div>

      <a href="#solutions" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-on-surface-muted transition-colors hover:text-on-surface hover:bg-surface">Solutions</a>
      <a href="#how-it-works" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-on-surface-muted transition-colors hover:text-on-surface hover:bg-surface">How it Works</a>
      <a href="#pricing" class="rounded-lg px-3.5 py-2 text-sm font-semibold text-on-surface-muted transition-colors hover:text-on-surface hover:bg-surface">Pricing</a>
    </nav>

    <!-- Desktop CTAs -->
    <div class="hidden lg:flex items-center gap-3">
      <a
        href={`${APP_URL}/employer/login`}
        class="text-sm font-semibold text-on-surface-muted transition-colors hover:text-on-surface"
      >
        Login
      </a>
      <a
        href={`${APP_URL}/book-demo`}
        class="rounded-pill bg-on-surface px-5 py-2.5 text-sm font-bold text-white transition-all hover:bg-primary hover:shadow-card-blue active:scale-[0.97]"
      >
        Book Demo
      </a>
    </div>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="lg:hidden flex items-center justify-center h-10 w-10 rounded-lg transition-colors hover:bg-surface"
      aria-label="Open menu"
    >
      <svg id="icon-open" class="h-5 w-5 text-on-surface" viewBox="0 0 20 20" fill="none">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <svg id="icon-close" class="h-5 w-5 text-on-surface hidden" viewBox="0 0 20 20" fill="none">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-border bg-white px-6 pb-6 pt-4"
  >
    <nav class="flex flex-col gap-1 mb-6">
      <p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-muted mb-2 mt-1">Product</p>
      {productLinks.map(link => (
        <a href={link.href} class="rounded-lg px-3 py-2.5 text-sm font-semibold text-on-surface hover:bg-surface-blue transition-colors">
          {link.label}
        </a>
      ))}
      <div class="my-2 h-px bg-border"></div>
      <a href="#solutions" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-on-surface hover:bg-surface transition-colors">Solutions</a>
      <a href="#how-it-works" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-on-surface hover:bg-surface transition-colors">How it Works</a>
      <a href="#pricing" class="rounded-lg px-3 py-2.5 text-sm font-semibold text-on-surface hover:bg-surface transition-colors">Pricing</a>
    </nav>
    <div class="flex flex-col gap-3">
      <a href={`${APP_URL}/employer/login`} class="block text-center rounded-xl border border-border py-3 text-sm font-bold text-on-surface hover:bg-surface transition-colors">
        Login
      </a>
      <a href={`${APP_URL}/book-demo`} class="block text-center rounded-pill bg-primary py-3 text-sm font-bold text-white hover:bg-primary-dark transition-colors">
        Book Demo
      </a>
    </div>
  </div>
</header>

<script>
  // Scroll behavior: add shadow + border on scroll
  const nav = document.getElementById('main-nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 10) {
      nav?.style.setProperty('border-bottom-color', '#e2e8f0');
      nav?.style.setProperty('box-shadow', '0 4px 24px rgba(0,0,0,0.06)');
    } else {
      nav?.style.setProperty('border-bottom-color', 'transparent');
      nav?.style.setProperty('box-shadow', 'none');
    }
  }, { passive: true });

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  btn?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });
</script>
