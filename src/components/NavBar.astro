---
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'http://localhost:5173';

const productLinks = [
  { label: 'Aptitude Assessment', desc: 'Role-specific aptitude tests', href: '#features' },
  { label: 'Adaptive Technical', desc: 'Difficulty adapts to performance', href: '#features' },
  { label: 'AI Video Interview', desc: 'Async AI-evaluated interviews', href: '#features' },
  { label: 'Coding Assessment', desc: 'Browser IDE + DSA evaluation', href: '#features' },
  { label: 'Candidate Intelligence', desc: 'Scorecards, evidence and ranking', href: '#intelligence' },
  { label: 'Bulk Screening', desc: 'Resume match and outreach at scale', href: '#features' },
];

const navigation = [
  { label: 'Why QuickRuit?', href: '#solutions' },
  { label: 'How it Works', href: '#how-it-works' },
  { label: 'Pricing', href: '#pricing' },
];
---

<header id="main-nav" class="sticky top-0 z-50 w-full border-b border-transparent bg-white/95 backdrop-blur-xl transition-all duration-300">
  <div class="mx-auto flex h-[72px] max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8">
    <a href="/" class="group flex shrink-0 items-center gap-2.5 rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2" aria-label="QuickRuit home">
      <img src="/assets/quickruit-logo.png" width="36" height="36" alt="" class="h-8 w-8 rounded-[10px] object-cover shadow-[0_8px_18px_rgba(0,82,255,0.22)] transition-transform duration-200 group-hover:-rotate-3 group-hover:scale-105" />
      <span class="text-[19px] font-black tracking-[-0.04em] text-on-surface">QuickRuit</span>
      <span class="hidden rounded-md border border-primary/15 bg-primary/8 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.16em] text-primary sm:inline">Beta</span>
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary navigation">
      <div class="relative" id="product-menu-wrap">
        <button id="product-menu-button" type="button" aria-expanded="false" aria-controls="product-menu" class="inline-flex items-center gap-1.5 rounded-lg px-3.5 py-2.5 text-sm font-semibold text-on-surface-muted transition-colors hover:bg-surface hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
          Features
          <svg id="product-chevron" class="h-3.5 w-3.5 transition-transform duration-200" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div id="product-menu" class="invisible absolute left-1/2 top-full w-[500px] -translate-x-1/2 translate-y-1 opacity-0 pt-3 transition-all duration-200" aria-hidden="true">
          <div class="rounded-2xl border border-border bg-white p-5 shadow-[0_22px_60px_rgba(15,31,58,0.14)]">
            <div class="mb-4 flex items-end justify-between gap-4">
              <div><p class="text-[10px] font-bold uppercase tracking-[0.18em] text-primary">QuickRuit platform</p><p class="mt-1 text-sm text-on-surface-muted">A complete first-round hiring workflow.</p></div>
              <span class="rounded-full bg-primary/8 px-2.5 py-1 text-[10px] font-bold text-primary">6 modules</span>
            </div>
            <div class="grid grid-cols-2 gap-1.5">
              {productLinks.map((link) => (
                <a href={link.href} class="group/item flex items-start gap-3 rounded-xl p-3 transition-colors hover:bg-surface-blue focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">
                  <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-primary/8 text-primary"><span class="h-1.5 w-1.5 rounded-full bg-current transition-transform group-hover/item:scale-150"></span></span>
                  <span><span class="block text-sm font-semibold text-on-surface transition-colors group-hover/item:text-primary">{link.label}</span><span class="mt-0.5 block text-xs leading-5 text-on-surface-muted">{link.desc}</span></span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
      {navigation.map((item) => <a href={item.href} class="rounded-lg px-3.5 py-2.5 text-sm font-semibold text-on-surface-muted transition-colors hover:bg-surface hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">{item.label}</a>)}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href={`${APP_URL}/employer/login`} class="rounded-lg px-2 py-2 text-sm font-semibold text-on-surface-muted transition-colors hover:text-on-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary">Login</a>
      <a href={`${APP_URL}/book-demo`} class="inline-flex items-center gap-2 rounded-full bg-primary px-5 py-2.5 text-sm font-bold text-white shadow-[0_10px_24px_rgba(0,82,255,0.18)] transition-all hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-card-blue active:scale-[0.97] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2">Request Demo <span aria-hidden="true">→</span></a>
    </div>

    <button id="mobile-menu-btn" type="button" class="flex h-10 w-10 items-center justify-center rounded-xl text-on-surface transition-colors hover:bg-surface focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary lg:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg id="icon-open" class="h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      <svg id="icon-close" class="hidden h-5 w-5" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-border bg-white px-5 pb-6 pt-4 lg:hidden" aria-hidden="true">
    <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
      <p class="mb-1 mt-1 px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-primary">Features</p>
      {productLinks.map((link) => <a href={link.href} class="rounded-xl px-3 py-2.5 text-sm font-semibold text-on-surface transition-colors hover:bg-surface-blue">{link.label}</a>)}
      <div class="my-2 h-px bg-border"></div>
      {navigation.map((item) => <a href={item.href} class="rounded-xl px-3 py-2.5 text-sm font-semibold text-on-surface transition-colors hover:bg-surface">{item.label}</a>)}
    </nav>
    <div class="mt-5 grid grid-cols-2 gap-3">
      <a href={`${APP_URL}/employer/login`} class="rounded-full border border-border py-3 text-center text-sm font-bold text-on-surface transition-colors hover:bg-surface">Login</a>
      <a href={`${APP_URL}/book-demo`} class="rounded-full bg-primary py-3 text-center text-sm font-bold text-white transition-colors hover:bg-primary-dark">Request Demo</a>
    </div>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const productButton = document.getElementById('product-menu-button');
  const productMenu = document.getElementById('product-menu');
  const productChevron = document.getElementById('product-chevron');
  const mobileButton = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  const setProductMenu = (open: boolean) => {
    productButton?.setAttribute('aria-expanded', String(open));
    productMenu?.setAttribute('aria-hidden', String(!open));
    productMenu?.classList.toggle('invisible', !open);
    productMenu?.classList.toggle('opacity-0', !open);
    productMenu?.classList.toggle('translate-y-1', !open);
    productMenu?.classList.toggle('opacity-100', open);
    productMenu?.classList.toggle('translate-y-0', open);
    productChevron?.classList.toggle('rotate-180', open);
  };

  productButton?.addEventListener('click', () => setProductMenu(productButton.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('click', (event) => { if (!productButton?.parentElement?.contains(event.target as Node)) setProductMenu(false); });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') { setProductMenu(false); productButton?.focus(); } });

  mobileButton?.addEventListener('click', () => {
    const open = mobileButton.getAttribute('aria-expanded') !== 'true';
    mobileButton.setAttribute('aria-expanded', String(open));
    mobileButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu?.classList.toggle('hidden', !open);
    mobileMenu?.setAttribute('aria-hidden', String(!open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    mobileButton?.setAttribute('aria-expanded', 'false');
    mobileMenu.classList.add('hidden');
    mobileMenu.setAttribute('aria-hidden', 'true');
    iconOpen?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }));

  window.addEventListener('scroll', () => {
    const elevated = window.scrollY > 10;
    nav?.classList.toggle('border-border', elevated);
    nav?.classList.toggle('shadow-[0_4px_24px_rgba(15,31,58,0.06)]', elevated);
  }, { passive: true });
</script>
